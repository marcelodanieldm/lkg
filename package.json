{
  "name": "lokigi-web",
  "version": "1.0.0",
  "private": true,
  "description": "Lokigi sobre Vercel + Supabase. El núcleo determinista es el mismo; cambia dónde viven los datos y quién programa las tareas.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.js",
    "verificar": "node scripts/verificar.js",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "auth": "node scripts/google-auth.js",
    "humo": "node --env-file=.env.local scripts/humo-places.js"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "supabase": "^2.0.0"
  }
}
