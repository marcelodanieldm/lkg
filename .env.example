# ─────────────────────────────────────────────────────────────────────
# Lokigi — variables de entorno
#
# Copiá este archivo a .env.local para desarrollo. En Vercel se cargan una
# por una en Settings › Environment Variables.
#
# REGLA QUE NO SE ROMPE: ninguna variable de acá lleva el prefijo
# NEXT_PUBLIC_ salvo las dos que están marcadas como públicas. Todo lo que
# empieza con NEXT_PUBLIC_ se compila DENTRO del JavaScript que baja el
# navegador: es visible para cualquiera que abra el inspector.
# `npm run verificar` revisa esto y falla si encuentra un secreto público.
# ─────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────
# Settings › API en el panel de Supabase.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# La clave de servicio IGNORA la seguridad de filas: con ella se lee y se
# escribe todo el CRM. Solo vive del lado del servidor. Si alguna vez aparece
# en el navegador, rotala en el acto desde el panel de Supabase.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Pública a propósito: no puede leer nada porque RLS está cerrado sin
# políticas. Solo hace falta para que `npm run verificar` compruebe
# justamente eso.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# ── La aplicación ────────────────────────────────────────────────────
# Pública a propósito: es la URL de los enlaces del informe y de la baja.
NEXT_PUBLIC_APP_URL=https://lokigi.vercel.app

# La contraseña del panel. Sin esto el CRM queda abierto en internet: Vercel
# despliega en un dominio adivinable y los rastreadores lo encuentran solos.
PANEL_PASSWORD=

# Lo único que separa /api/cron y /api/guard de un botón público. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# El mismo valor va cargado en Vault dentro de Supabase (ver migración 002).
LOKIGI_API_KEY=

# Lo pone Vercel solo si usás su cron. No hace falta tocarlo.
CRON_SECRET=

# ── Google (Gmail, Sheets, Docs, Drive, Calendar) ────────────────────
# Un solo proyecto de Google Cloud, un solo refresh token, todos los alcances.
# Se genera con: node scripts/google-auth.js
#
# IMPORTANTE: publicá la app en la pantalla de consentimiento de Google Cloud.
# Mientras figure en estado "Prueba", el refresh token CADUCA CADA 7 DÍAS y
# Lokigi deja de mandar correos sin avisar.
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxx

# El buzón desde el que sale la prospección. Que sea un DOMINIO DEDICADO,
# distinto del que usás con tus clientes: si la prospección junta quejas, se
# quema ese dominio y no tu correo de trabajo.
# Una cuenta @gmail.com personal no sirve — Google restringe el envío
# comercial en volumen desde cuentas personales.
GMAIL_FROM=hola@prospeccion-lokigi.com

# A dónde te llegan los avisos del Supervisor y las propuestas listas.
EMAIL_OPERADOR=

# Dirección que aparece en el mailto: de la baja. Si no está, se usa GMAIL_FROM.
EMAIL_BAJA=

# ── Gemini ───────────────────────────────────────────────────────────
# Nivel gratuito, sin tarjeta: aistudio.google.com/apikey
#
# Tené en cuenta que Google se reserva el derecho de usar los prompts del
# nivel gratuito para entrenar. Por acá pasan nombres de negocios reales.
# Activar facturación (2 a 5 USD al mes a este volumen) desactiva ese uso.
GEMINI_API_KEY=
GEMINI_FACTURADO=

# ── Places API (New) ─────────────────────────────────────────────────
# Sin esto el sistema corre en modo demo con los perfiles de lib/core/demo.js.
GOOGLE_MAPS_API_KEY=

# ── Identidad ────────────────────────────────────────────────────────
AGENCIA_NOMBRE=Lokigi
AGENCIA_REMITENTE=Marcelo — Lokigi

# ── Opcional ─────────────────────────────────────────────────────────
# Solo si conectás el webhook de Gmail por Pub/Sub (ver app/api/webhook/gmail).
PUBSUB_TOKEN=

# Quién firma la landing y los informes. Sin esto la página muestra
# [TU CIUDAD] y [TU NOMBRE] entre corchetes, a propósito.
AGENCIA_CIUDAD=Rosario
AGENCIA_PERSONA=Marcelo
